{
  "name": "yannrzy",
  "version": "4.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --expose-gc index.js",
    "start:wa": "node --expose-gc index.js --wa",
    "start:tg": "node --expose-gc index.js --tg",
    "start:both": "node --expose-gc index.js --both",
    "scan": "npx -p typescript tsc --allowJs --checkJs --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck --strict false --noImplicitAny false index.js handler.js config.js lib/*.js plugins/*/*.js",
    "pm2": "pm2 start index.js --name yannrzy --node-args=\"--expose-gc\" --kill-timeout 8000 --exp-backoff-restart-delay=2000"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@hapi/boom": "^10.0.1",
    "@napi-rs/canvas": "^0.1.88",
    "@rafxzflow/multiscript": "^1.0.0",
    "@ryuu-reinzz/luna-lib": "4.2.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "adm-zip": "^0.5.16",
    "archiver": "^8.0.0",
    "awesome-phonenumber": "^7.7.0",
    "axios": "^1.13.3",
    "brat-canvas": "^1.0.26",
    "btch-downloader": "^6.0.25",
    "chalk": "^5.3.0",
    "cheerio": "1.0.0-rc.12",
    "chokidar": "^3.6.0",
    "file-type": "^21.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.5",
    "got-scraping": "^4.1.1",
    "he": "^1.2.0",
    "javascript-obfuscator": "^4.1.1",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.2",
    "mime-types": "^3.0.2",
    "moment-timezone": "^0.6.0",
    "node-fetch": "^2.7.0",
    "node-webpmux": "^3.2.1",
    "pdfkit": "^0.20.2",
    "pino": "^8.14.1",
    "puppeteer": "^19.0.0",
    "puppeteer-screen-recorder": "^3.0.6",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "qs": "^6.14.1",
    "sharp": "^0.33.3",
    "tough-cookie": "^5.1.2",
    "undici": "^7.22.0",
    "yt-search": "^2.13.1"
  }
}
